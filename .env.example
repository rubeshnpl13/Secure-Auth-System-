PORT=3000
NODE_ENV=development

# Local Docker PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=secure_auth
DB_USER=secure_auth_app
DB_PASSWORD=replace_with_a_secure_local_password

# Production managed PostgreSQL (Neon)
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

JWT_ACCESS_SECRET=generate_a_64_plus_character_secret
FRONTEND_ORIGIN=http://localhost:3000